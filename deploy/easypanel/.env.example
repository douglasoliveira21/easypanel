# =============================================================================
# EasyPanel — variáveis para deploy via painel EasyPanel.io (Compose service)
#
# O painel detecta este arquivo automaticamente (Build Path: /deploy/easypanel)
# e pré-popula o editor de variáveis de ambiente do serviço. Preencha os
# valores reais lá dentro do painel — NUNCA versione um .env real aqui.
# =============================================================================

# ---- Ambiente / imagens ----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
API_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=easypanel
POSTGRES_USER=easypanel
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ---- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- Autenticação / JWT ----------------------------------------------------
JWT_ISSUER=easypanel
JWT_AUDIENCE=easypanel
# Chave de assinatura HMAC forte (mín. 32 bytes). Gere com um segredo aleatório.
JWT_SIGNING_KEY=CHANGE_ME_generate_a_long_random_signing_key

# ---- Bootstrap (primeiro acesso) -------------------------------------------
# Se AMBOS forem preenchidos, um usuário Super Admin é criado na primeira
# inicialização (idempotente). Deixe em branco para não criar ninguém.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# ---- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
