# =============================================================================
# EasyPanel — Exemplo de variáveis de ambiente (R1.6)
#
# Copie este arquivo para `.env` no mesmo diretório e preencha os valores reais.
# NUNCA versione o arquivo `.env` (já ignorado no .gitignore).
# Todos os valores abaixo são PLACEHOLDERS — troque por segredos fortes.
# =============================================================================

# ---- Ambiente / imagens ----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
# API_REPLICAS=2

# ---- Proxy / TLS (Caddy) ---------------------------------------------------
# Em development pode usar ":80". Em staging/prod use um domínio público.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=admin@example.com

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=easypanel
POSTGRES_USER=easypanel
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ---- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- MinIO (S3) ------------------------------------------------------------
MINIO_ROOT_USER=easypanel
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET=easypanel

# ---- Autenticação / JWT ----------------------------------------------------
JWT_ISSUER=easypanel
JWT_AUDIENCE=easypanel
# Chave de assinatura HMAC forte (mín. 32 bytes). Gere com um segredo aleatório.
JWT_SIGNING_KEY=CHANGE_ME_generate_a_long_random_signing_key

# ---- Bootstrap (primeiro acesso) -------------------------------------------
# Se AMBOS forem preenchidos, um usuário Super Admin é criado na primeira
# inicialização (idempotente — não recria se já existir). Deixe em branco para
# não criar nenhum usuário automaticamente (sem dados fictícios).
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# ---- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
