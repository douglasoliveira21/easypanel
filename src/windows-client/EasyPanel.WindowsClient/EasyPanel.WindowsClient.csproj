<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Host do Agente Windows (Fase 2): Worker Service que descobre e monitora
    impressoras e reporta ao backend. Solução-satélite independente; consome só a
    API HTTP. O núcleo é mantido em net10.0 (multi-plataforma) para ser testável
    em qualquer SO; a hospedagem como Windows Service usa
    Microsoft.Extensions.Hosting.WindowsServices, disponível neste TFM.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>easypanel-windows-client</UserSecretsId>
    <RootNamespace>EasyPanel.WindowsClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!--
      Fila local offline em SQLite (R5.4). Fixa-se o bundle nativo 2.1.13 pela
      mesma correção de segurança aplicada nos projetos de teste do backend
      (CVE-2025-6965 no SQLite empacotado por versões anteriores).
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyPanel.WindowsClient.Snmp\EasyPanel.WindowsClient.Snmp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
